<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
		<TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <AssemblyName>UnionTypes.Toolkit</AssemblyName>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <TransformOnBuild>True</TransformOnBuild>
    <Authors>Matt Warren</Authors>
    <Description>A collection of common union types and tools to build custom ones.</Description>
    <PackageProjectUrl>https://github.com/mattwar/UnionTypes.Toolkit</PackageProjectUrl>
    <PackageReadmeFile>ReadMe.Nuget.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/mattwar/UnionTypes.Toolkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <IncludeSymbols>True</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="ReadMe.Nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <!-- Cross-platform, SDK-only T4 engine: runs via dotnet build/CI, not just inside Visual Studio -->
  <ItemGroup>
    <PackageReference Include="T4.BuildTools" Version="3.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <T4Transform Include="Standard_Unions_generated.tt" />
    <Compile Update="Standard_Unions_generated.cs">
      <DependentUpon>Standard_Unions_generated.tt</DependentUpon>
    </Compile>
    <T4Transform Include="Fat_Unions_generated.tt" />
    <Compile Update="Fat_Unions_generated.cs">
      <DependentUpon>Fat_Unions_generated.tt</DependentUpon>
    </Compile>

  </ItemGroup>

</Project>
